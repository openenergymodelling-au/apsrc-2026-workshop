// Layout for the workshop program: where things go and how they're arranged.
//
// Fonts, colours and sizes come from the active theme (theme-modern.typ or
// theme-academic.typ), so restyling shouldn't need changes here.
//
// The functions below are called from the code generated by
// filters/program.lua.

#let theme-state = state("program-theme", none)

// Call `f` with the active theme dictionary.
#let with-theme(f) = context f(theme-state.get())

#let meta-sep = [ · ]

// Whole-document set-up: page, fonts, headings, footer.
#let program-doc(theme: none, title: none, footer: none, page-numbers: true, draft: false, body) = {
  let t = theme
  set document(title: title)
  theme-state.update(t)

  set page(
    paper: "a4",
    margin: t.margin,
    // Faint diagonal "DRAFT" across every page while the program is a draft.
    background: if draft {
      rotate(-40deg, text(font: t.heading-font, size: 130pt, weight: 700, fill: t.watermark, tracking: 0.05em)[DRAFT])
    },
    footer: {
      set text(font: t.body-font, size: t.small-size, fill: t.muted)
      footer
      h(1fr)
      if page-numbers { context counter(page).display("1") }
    },
  )
  set text(font: t.body-font, size: t.body-size, fill: t.text, lang: "en", region: "AU")
  set par(leading: t.leading, spacing: t.par-spacing, justify: t.justify)
  show link: set text(fill: t.link-color)

  show heading: set text(font: t.heading-font, fill: t.heading-color, weight: t.heading-weight)
  show heading.where(level: 1): it => block(
    width: 100%,
    above: 1.6em,
    below: 1em,
    inset: (bottom: 0.4em),
    stroke: (bottom: t.h1-rule),
    sticky: true,
    text(size: t.h1-size, it.body),
  )
  show heading.where(level: 2): it => block(
    above: 1.3em,
    below: 0.55em,
    sticky: true,
    text(size: t.h2-size, it.body),
  )

  body
}

// Draft notice above the header.
#let draft-banner(body, t) = block(
  width: 100%,
  inset: (x: 10pt, y: 7pt),
  below: 1.2em,
  radius: 3pt,
  fill: t.draft-fill,
  stroke: 0.8pt + t.draft-stroke,
  text(size: t.small-size + 0.6pt, body),
)

// Title block at the top of the schedule.
#let event-header(
  kicker: none,
  title: none,
  date: none,
  time: none,
  venue: none,
  note: none,
  support: none,
  logos: (),
  draft: none,
) = with-theme(t => {
  set align(t.header-align)
  set text(hyphenate: false)
  set par(justify: false)
  if draft != none { draft-banner(draft, t) }
  block(width: 100%, below: 1.2em, {
    if kicker != none and t.show-kicker {
      block(below: 0.55em, text(
        size: t.kicker-size,
        weight: t.kicker-weight,
        fill: t.kicker-color,
        kicker,
      ))
    }
    block(below: 1em, text(
      font: t.heading-font,
      size: t.title-size,
      weight: t.title-weight,
      fill: t.title-color,
      title,
    ))
    set text(size: t.meta-size)
    if date != none { block(below: 0.4em, text(weight: t.date-weight, date)) }
    if time != none { block(below: 0.4em, time) }
    let place = (venue, note).filter(x => x != none)
    if place.len() > 0 { block(below: 0.4em, text(fill: t.muted, place.join(meta-sep))) }
    if support != none { block(below: 0.4em, text(fill: t.muted, support)) }
    if logos.len() > 0 {
      block(above: 1em, stack(
        dir: ltr,
        spacing: 8mm,
        ..logos.map(l => box(height: t.logo-height, l)),
      ))
    }
    if t.header-rule != none {
      block(above: 1em, line(length: 100%, stroke: t.header-rule))
    }
  })
})

// "Name (Affiliation)" for the schedule. Prefers the short affiliation.
#let speaker-short(sp) = {
  let aff = sp.at("affiliation-short")
  if aff == none { aff = sp.at("affiliation") }
  sp.name
  if aff != none [ (#aff)]
}

#let speakers-short(speakers) = speakers.map(speaker-short).join(", ", last: " & ")

// Paper-style author list for the talk details: names on one line (the
// presenter in bold), then the affiliations. With more than one affiliation,
// superscript numbers link each author to theirs. Honorifics (Dr, Prof...)
// are shown for single authors only, to keep longer author lists clean.
#let author-list(authors, affiliations, t) = {
  let numbered = affiliations.len() > 1
  let honorifics = authors.len() == 1
  block(above: 0.3em, below: 0.35em, authors.map(a => {
    text(weight: if a.presenter { t.speaker-weight } else { "regular" }, {
      if honorifics and a.honorific != none [#a.honorific ]
      a.name
    })
    if numbered and a.affil != none { super(str(a.affil)) }
  }).join(", "))
  if affiliations.len() > 0 {
    block(above: 0.35em, below: 0.3em, text(fill: t.muted, {
      if numbered {
        affiliations.enumerate().map(((i, aff)) => [#super(str(i + 1))#aff]).join(h(1.2em))
      } else {
        affiliations.first()
      }
    }))
  }
}

// Talks listed under a session in the schedule.
#let schedule-talks(talks, t) = {
  let item(talk) = block(
    width: 100%,
    inset: (left: 7pt, y: 1pt),
    stroke: (left: t.talk-marker),
    breakable: false,
    {
      text(weight: t.talk-weight, talk.title)
      if talk.speakers.len() > 0 {
        linebreak()
        text(size: t.small-size, fill: t.muted, speakers-short(talk.speakers))
      }
    },
  )
  // Long lists (e.g. lightning talks) switch to two columns.
  let cols = if talks.len() > t.two-columns-after { 2 } else { 1 }
  grid(
    columns: (1fr,) * cols,
    column-gutter: 12pt,
    row-gutter: t.talk-list-gap,
    ..talks.map(item),
  )
}

// The one-page schedule.
#let schedule-table(sessions) = with-theme(t => {
  // Narrow columns: ragged-right reads better than justified.
  set par(justify: false)
  let cells = ()
  // Rows never split across pages: a session that does not fit moves whole.
  for s in sessions {
    let is-break = s.kind == "break"
    let fill = if is-break { t.break-fill } else { none }
    cells.push(grid.cell(fill: fill, breakable: false, text(fill: t.time-color, weight: t.time-weight, s.time)))
    cells.push(grid.cell(fill: fill, breakable: false, {
      text(
        size: t.session-size,
        weight: if is-break { t.break-weight } else { t.session-weight },
        fill: t.session-color,
        s.title,
      )
      if s.description != none {
        block(above: 0.45em, below: 0pt, text(size: t.small-size, fill: t.muted, s.description))
      }
      if s.talks.len() > 0 {
        block(above: 0.8em, below: 0.2em, schedule-talks(s.talks, t))
      }
    }))
  }
  grid(
    columns: (t.time-width, 1fr),
    inset: (x, y) => (left: if x == 0 { 7pt } else { 12pt }, right: 7pt, y: t.row-pad),
    stroke: (x, y) => (
      top: if y > 0 { t.row-rule },
      bottom: if y == sessions.len() - 1 { t.row-rule },
    ),
    ..cells,
  )
})

// One talk in the details section.
#let talk-entry(title: none, authors: (), affiliations: (), links: (), abstract: none) = with-theme(t => {
  // Keep each talk on one page (talks are much shorter than a page).
  block(width: 100%, above: t.talk-gap, below: t.talk-gap, breakable: false, {
    // Keep the title and authors with the start of the abstract.
    block(sticky: true, below: 0.9em, {
      set par(justify: false)
      block(below: 0.45em, text(
        font: t.heading-font,
        size: t.talk-title-size,
        weight: t.talk-title-weight,
        fill: t.heading-color,
        title,
      ))
      author-list(authors, affiliations, t)
    })
    abstract
    if links.len() > 0 {
      set text(size: t.small-size)
      // Keep a talk's links together on one page.
      block(above: 1em, breakable: false, stack(spacing: 0.65em, ..links.map(l => {
        if l.label != none { text(weight: 600, l.label); [: ] }
        link(l.url, l.url.replace(regex("^https?://"), "").trim("/", at: end))
      })))
    }
  })
  if t.talk-rule != none { line(length: 100%, stroke: t.talk-rule) }
})

// Highlighted placeholder for content still to come.
#let todo-box(body) = with-theme(t => block(
  width: 100%,
  inset: (x: 9pt, y: 7pt),
  radius: 3pt,
  fill: t.todo-fill,
  stroke: 0.6pt + t.todo-stroke,
  {
    set text(size: t.small-size)
    text(weight: 700)[To do: ]
    body
  },
))
